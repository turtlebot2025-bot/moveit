<?xml version="1.0" encoding="utf-8"?>
<!-- complete_assembly.urdf
     ─────────────────────────────────────────────────────────────────────────
     5-DOF arm + parallel gripper for pca9685_arm_robot package.

     ros2_control plugin:  pca9685_arm_robot/PCA9685ArmRobot
     I2C:                  Jetson AGX Orin bus 7, PCA9685 addr 0x40

     Channel map:
       ch 0  shoulder_joint       (±1.57 rad, pulse 1358–2058 µs)
       ch 1  elbow_joint          (±1.57 rad, pulse  370–2630 µs)
       ch 2  rotating_base_joint  (±3.14 rad, pulse  280–2540 µs)
       ch 3  wrist_joint          (±1.57 rad, pulse  530–2310 µs)
       ch 4  gripper_joint        (±1.57 rad, pulse  620–2760 µs)
       ch 5  right_gear_joint     (±1.57 rad, pulse  620–2760 µs) — finger actuator
       ch-1  mimic joints         (no servo — state from right_gear_joint × 1 + 0)

     Controller ownership:
       arm_controller      → rotating_base, shoulder, elbow, wrist, gripper_joint
       gripper_controller  → right_gear_joint only
       joint_state_broadcaster → all 11 joints
     ─────────────────────────────────────────────────────────────────────────
-->
<robot name="complete_assembly">

  <link name="world"/>
  <joint name="world_fixed_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="base_link"/>
  <joint name="base_link_to_fixed_base" type="fixed">
    <parent link="base_link"/>
    <child link="fixed_base"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- ── fixed_base ───────────────────────────────────────────────────────── -->
  <link name="fixed_base">
    <inertial>
      <origin xyz="-0.0129802138796697 0.0289181576077138 -0.0243127481279135" rpy="0 0 0"/>
      <mass value="0.0944551427512308"/>
      <inertia ixx="0.000129607400367704" ixy="1.50360291317691E-06" ixz="3.38108959132247E-06"
               iyy="0.000192218344593774" iyz="2.77200835499892E-05" izz="0.000146583546079235"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/fixed_base.STL"/></geometry>
      <material name=""><color rgba="0.498 0.498 0.498 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/fixed_base.STL"/></geometry>
    </collision>
  </link>

  <!-- ── rotating_base ────────────────────────────────────────────────────── -->
  <link name="rotating_base">
    <inertial>
      <origin xyz="0.00892579137353103 0.0440191723132462 -0.00543608203143876" rpy="0 0 0"/>
      <mass value="0.118965826503535"/>
      <inertia ixx="0.000184656310145483" ixy="-1.20401033134862E-05" ixz="1.65983524667134E-06"
               iyy="9.1902926345823E-05"  iyz="1.94222326953776E-05"  izz="0.000137468053056806"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/rotating_base.STL"/></geometry>
      <material name=""><color rgba="0.969 0.259 0.259 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/rotating_base.STL"/></geometry>
    </collision>
  </link>
  <joint name="rotating_base_joint" type="revolute">
    <origin xyz="-0.013849 0.030652 0.015193" rpy="-1.8219 0.39346 -2.177"/>
    <parent link="fixed_base"/>
    <child  link="rotating_base"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="1" velocity="1"/>
  </joint>

  <!-- ── shoulder ─────────────────────────────────────────────────────────── -->
  <link name="shoulder">
    <inertial>
      <origin xyz="-5.98267976478772E-08 -0.140000036111509 -0.0049727768626128" rpy="0 0 0"/>
      <mass value="0.173985862227821"/>
      <inertia ixx="0.00120103847110696" ixy="-3.03260149397586E-09" ixz="6.5658408641674E-11"
               iyy="2.82234756492875E-05" iyz="5.60238761252666E-10"  izz="0.00121634489140425"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/shoulder.STL"/></geometry>
      <material name=""><color rgba="0.694 0.098 0.098 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/shoulder.STL"/></geometry>
    </collision>
  </link>
  <joint name="shoulder_joint" type="revolute">
    <origin xyz="0 0.06702 -0.011931" rpy="1.5708 -1.154 1.5708"/>
    <parent link="rotating_base"/>
    <child  link="shoulder"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="1" velocity="1"/>
  </joint>

  <!-- ── elbow ────────────────────────────────────────────────────────────── -->
  <link name="elbow">
    <inertial>
      <origin xyz="0.0967620017476869 -1.66885552552176E-05 0.0100790586435994" rpy="0 0 0"/>
      <mass value="0.0896278030340915"/>
      <inertia ixx="1.45996540350183E-05" ixy="1.36641926893841E-07" ixz="1.83145079336707E-06"
               iyy="0.000320802080195619" iyz="-7.19355817575536E-10" izz="0.000328740695066058"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/elbow.STL"/></geometry>
      <material name=""><color rgba="0.694 0.098 0.098 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/elbow.STL"/></geometry>
    </collision>
  </link>
  <joint name="elbow_joint" type="revolute">
    <origin xyz="0 -0.28 0" rpy="0 0 -0.77026"/>
    <parent link="shoulder"/>
    <child  link="elbow"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="1" velocity="1"/>
  </joint>

  <!-- ── wrist ────────────────────────────────────────────────────────────── -->
  <link name="wrist">
    <inertial>
      <origin xyz="-0.0075869494577985 0.0184119230556328 0.000866391264563837" rpy="0 0 0"/>
      <mass value="0.0159127959387036"/>
      <inertia ixx="4.54918840935408E-06" ixy="3.15957669878946E-07"  ixz="5.7776585613333E-07"
               iyy="2.50816962568845E-06" iyz="2.26456499563466E-07"  izz="4.10683416536016E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/wrist.STL"/></geometry>
      <material name=""><color rgba="0.498 0.498 0.498 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/wrist.STL"/></geometry>
    </collision>
  </link>
  <joint name="wrist_joint" type="revolute">
    <origin xyz="0.192 0.0053 0.0095" rpy="3.1416 0.96644 1.5708"/>
    <parent link="elbow"/>
    <child  link="wrist"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1" velocity="1"/>
  </joint>

  <!-- ── gripper body ──────────────────────────────────────────────────────── -->
  <link name="gripper">
    <inertial>
      <origin xyz="-0.0181833499348664 -0.0182646322506441 0.00467440246505202" rpy="0 0 0"/>
      <mass value="0.0160520536785178"/>
      <inertia ixx="5.96148264762733E-06" ixy="-3.15112541913268E-06" ixz="1.33133889830625E-06"
               iyy="6.35205137443899E-06" iyz="1.25981426227068E-06"  izz="7.26676598513188E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/gripper.STL"/></geometry>
      <material name=""><color rgba="0.843 0.816 0.753 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/gripper.STL"/></geometry>
    </collision>
  </link>
  <joint name="gripper_joint" type="revolute">
    <origin xyz="-0.020533 0.02425 -0.0081026" rpy="2.1829 0.14928 -1.4667"/>
    <parent link="wrist"/>
    <child  link="gripper"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.57" upper="1.57" effort="1" velocity="1"/>
  </joint>

  <!-- ── right_link ────────────────────────────────────────────────────────── -->
  <link name="right_link">
    <inertial>
      <origin xyz="-5.55111512312578E-17 -0.0141775766650648 -0.00626468833272781" rpy="0 0 0"/>
      <mass value="0.000819182765433024"/>
      <inertia ixx="1.09384456847925E-07" ixy="1.08599767140263E-23" ixz="6.10045701757858E-24"
               iyy="2.07077874970526E-08" iyz="-3.85199714838046E-08" izz="9.08611567253607E-08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/right_link.STL"/></geometry>
      <material name=""><color rgba="0 0.502 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/right_link.STL"/></geometry>
    </collision>
  </link>
  <joint name="right_link_joint" type="revolute">
    <origin xyz="-0.041738 -0.04334 0.0095011" rpy="-0.68328 0 -1.0357"/>
    <parent link="gripper"/>
    <child  link="right_link"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="1" velocity="1"/>
    <mimic joint="right_gear_joint" multiplier="1" offset="0"/>
  </joint>

  <!-- ── left_link ─────────────────────────────────────────────────────────── -->
  <link name="left_link">
    <inertial>
      <origin xyz="-5.55111512312578E-17 -0.008933845343992 -0.0126663494097404" rpy="0 0 0"/>
      <mass value="0.000819182765433022"/>
      <inertia ixx="1.09384456847925E-07" ixy="4.17467715397856E-24"  ixz="-8.42690249038397E-24"
               iyy="7.32673306471969E-08" iyz="-4.90765897760274E-08" izz="3.83016135752161E-08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/left_link.STL"/></geometry>
      <material name=""><color rgba="0 0.502 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/left_link.STL"/></geometry>
    </collision>
  </link>
  <joint name="left_link_joint" type="revolute">
    <origin xyz="-0.041738 -0.04334 -0.00049887" rpy="-0.68328 0 -1.0357"/>
    <parent link="gripper"/>
    <child  link="left_link"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="1" velocity="1"/>
    <mimic joint="right_gear_joint" multiplier="1" offset="0"/>
  </joint>

  <!-- ── right_gear ────────────────────────────────────────────────────────── -->
  <link name="right_gear">
    <inertial>
      <origin xyz="-5.55111512312578E-17 -0.00482849054752199 -0.0027984078900079" rpy="0 0 0"/>
      <mass value="0.00645515105378562"/>
      <inertia ixx="1.1297062678487E-06"  ixy="-1.29557163441118E-22" ixz="-1.63781761285499E-22"
               iyy="3.70927587811473E-07"  iyz="-2.45824875202671E-07" izz="8.66364530933653E-07"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/right_gear.STL"/></geometry>
      <material name=""><color rgba="1 0.937 0.137 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/right_gear.STL"/></geometry>
    </collision>
  </link>
  <joint name="right_gear_joint" type="revolute">
    <origin xyz="-0.023 -0.03572 0.018398" rpy="-0.68328 0 -1.0357"/>
    <parent link="gripper"/>
    <child  link="right_gear"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="1" velocity="1"/>
  </joint>

  <!-- ── right_finger ──────────────────────────────────────────────────────── -->
  <link name="right_finger">
    <inertial>
      <origin xyz="-8.08870043167431E-09 -0.0292616104942388 -0.0346447916611542" rpy="0 0 0"/>
      <mass value="0.00531392173232632"/>
      <inertia ixx="4.13024457365969E-06" ixy="4.88046272975276E-13"  ixz="-1.1615250036033E-12"
               iyy="1.9414127094135E-06"  iyz="-1.96707935921573E-06" izz="2.20676640360276E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/right_finger.STL"/></geometry>
      <material name=""><color rgba="0.792 0.820 0.933 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/right_finger.STL"/></geometry>
    </collision>
  </link>
  <joint name="right_finger_joint" type="revolute">
    <origin xyz="-0.00725 -0.028069 -0.012558" rpy="0 0 0"/>
    <parent link="right_gear"/>
    <child  link="right_finger"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="1" velocity="1"/>
    <mimic joint="right_gear_joint" multiplier="1" offset="0"/>
  </joint>

  <!-- ── left_gear ─────────────────────────────────────────────────────────── -->
  <link name="left_gear">
    <inertial>
      <origin xyz="0 -0.0036180844836266 -0.00424910253532551" rpy="0 0 0"/>
      <mass value="0.00645515105378561"/>
      <inertia ixx="1.1297062678487E-06"  ixy="2.2835354785292E-22"  ixz="8.76811449306209E-23"
               iyy="7.63820614784737E-07"  iyz="-3.17362031254289E-07" izz="4.73471503960386E-07"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/left_gear.STL"/></geometry>
      <material name=""><color rgba="1 0.937 0.137 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/left_gear.STL"/></geometry>
    </collision>
  </link>
  <joint name="left_gear_joint" type="revolute">
    <origin xyz="-0.023 -0.03572 -0.0085012" rpy="-0.68328 0 -1.0357"/>
    <parent link="gripper"/>
    <child  link="left_gear"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="1" velocity="1"/>
    <mimic joint="right_gear_joint" multiplier="1" offset="0"/>
  </joint>

  <!-- ── left_finger ───────────────────────────────────────────────────────── -->
  <link name="left_finger">
    <inertial>
      <origin xyz="-8.08606237523435E-09 -0.0394685530338367 0.0223324152400109" rpy="0 0 0"/>
      <mass value="0.00531392171589627"/>
      <inertia ixx="4.13024461355846E-06"  ixy="-1.05195308945374E-12" ixz="-6.93715040579858E-13"
               iyy="1.4810171666742E-06"   iyz="1.88023120900998E-06"  izz="2.66716198619106E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/left_finger.STL"/></geometry>
      <material name=""><color rgba="0.792 0.820 0.933 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://pca9685_arm_robot/meshes/left_finger.STL"/></geometry>
    </collision>
  </link>
  <joint name="left_finger_joint" type="revolute">
    <origin xyz="-0.00725 -0.017383 -0.025365" rpy="3.1416 0 -3.1416"/>
    <parent link="left_gear"/>
    <child  link="left_finger"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="1" velocity="1"/>
    <mimic joint="right_gear_joint" multiplier="1" offset="0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════════════════
       ros2_control block
       Plugin:  pca9685_arm_robot/PCA9685ArmRobot  (Python, loaded via pluginlib)
       Using mock_components/GenericSystem so pluginlib finds a C++ plugin;
       pca9685_i2c_node (Python) handles real I2C via /joint_states subscription.
       ═══════════════════════════════════════════════════════════════════════ -->
  <ros2_control name="pca9685_arm_robot" type="system">

    <hardware>
      <!-- mock_components/GenericSystem is a built-in C++ plugin that always
           loads successfully.  Real servo driving is done by pca9685_i2c_node
           which subscribes to /joint_states published by joint_state_broadcaster. -->
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>

    <!-- ── Actuated joints ──────────────────────────────────────────────── -->

    <joint name="rotating_base_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max"> 3.14</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <joint name="shoulder_joint">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max"> 1.57</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <joint name="elbow_joint">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max"> 1.57</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <joint name="wrist_joint">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max"> 1.57</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <joint name="gripper_joint">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max"> 1.57</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- PRIMARY finger actuator — all mimic joints follow this one -->
    <joint name="right_gear_joint">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max"> 1.57</param>
      </command_interface>
      <state_interface name="position"/>
    </joint>

    <!-- ── Mimic joints — state interfaces only, no command interface ───── -->
    <!-- robot_state_publisher propagates right_gear_joint state to these    -->
    <!-- via URDF <mimic> tags. pca9685_i2c_node skips them (no servo).     -->

    <joint name="right_link_joint">
      <state_interface name="position"/>
    </joint>

    <joint name="left_link_joint">
      <state_interface name="position"/>
    </joint>

    <joint name="left_gear_joint">
      <state_interface name="position"/>
    </joint>

    <joint name="right_finger_joint">
      <state_interface name="position"/>
    </joint>

    <joint name="left_finger_joint">
      <state_interface name="position"/>
    </joint>

  </ros2_control>

</robot>