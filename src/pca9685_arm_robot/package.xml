<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pca9685_arm_robot</name>
  <version>0.1.0</version>
  <description>
    ros2_control SystemInterface plugin for arm_robot_pkg — a 5-DOF
    servo arm (base, shoulder, elbow, wrist, gripper) driven by a PCA9685
    PWM controller over I2C on the Jetson AGX Orin.
  </description>

  <maintainer email="tashenlrana@gmail.com">cojetson</maintainer>
  <license>Apache-2.0</license>

  <!-- Pure Python package: uses ament_python, NOT ament_cmake -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime ROS 2 dependencies -->
  <depend>rclpy</depend>
  <depend>hardware_interface</depend>
  <depend>controller_manager</depend>
  <depend>pluginlib</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>joint_trajectory_controller</depend>
  <depend>robot_state_publisher</depend>

  <!-- Python library for I2C communication with PCA9685 -->
  <exec_depend>python3-smbus2</exec_depend>

  <!-- Test dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>




  <export>
    <!-- This MUST be ament_python for a pure Python package -->
    <hardware_interface plugin="${prefix}/pca9685_arm_robot_plugin.xml"/>
    <build_type>ament_python</build_type>
  </export>
</package>