  </link>

  <joint name="left_finger_joint" type="revolute">
    <origin xyz="0.035542 0.0099013 0.0145" rpy="-3.1416 0 1.12"/>
    <parent link="left_gear"/>
    <child link="left_finger"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
