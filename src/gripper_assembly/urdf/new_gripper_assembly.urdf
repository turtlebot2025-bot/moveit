  </link>

  <joint name="left_link_joint" type="revolute">
    <origin xyz="-0.013034 -0.036616 -0.010046" rpy="-3.1416 0 -2.3005"/>
    <parent link="gripper"/>
    <child link="left_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    <mimic joint="right_gear_joint" multiplier="1" offset="0"/>
  </joint>

  <!-- ===================== RIGHT FINGER ===================== -->
  <link name="right_finger">
    <inertial>
      <origin
        xyz="0.0332544525627715 0.00990186713364257 0.00225000811833941"
        rpy="0 0 0"/>
      <mass value="0.00531392196719298"/>
      <inertia
        ixx="5.35709045890399E-07"
        ixy="-1.23304111671055E-06"
        ixz="-8.10212655967829E-13"
        iyy="3.61247019034449E-06"
        iyz="9.83693136764357E-13"
        izz="4.1302446962185E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://gripper_assembly/meshes/right_finger.STL"/>
      </geometry>
      <material name="finger_color">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://gripper_assembly/meshes/right_finger.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_finger_joint" type="revolute">
    <origin xyz="0.035482 0.0099303 0" rpy="-3.1416 0 1.1261"/>
    <parent link="right_gear"/>
    <child link="right_finger"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    <mimic joint="right_gear_joint" multiplier="1" offset="0"/>
  </joint>

  <!-- ===================== LEFT FINGER ===================== -->
  <link name="left_finger">
    <inertial>
      <origin
        xyz="0.0332544531718166 0.00990186656694004 0.00225000811833937"
        rpy="0 0 0"/>
      <mass value="0.00531392201150648"/>
      <inertia
        ixx="5.35709194537405E-07"
        ixy="-1.23304110552929E-06"
        ixz="-8.12576129511237E-13"
        iyy="3.61247040368807E-06"
        iyz="9.89621217064405E-13"
